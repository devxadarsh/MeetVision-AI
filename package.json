{
  "name": "meetvision-ai",
  "version": "1.0.0",
  "description": "MeetVision AI - Meeting Overlay Assistant providing real-time question detection and answers invisible to screen shares",
  "author": "MeetVision AI Team",
  "main": "dist-electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "npm run dev",
    "dev": "concurrently -k -s first \"npm run dev:ng\" \"wait-on http-get://localhost:4200 && npm run dev:electron\"",
    "dev:ng": "ng serve",
    "dev:electron": "npm run build:electron && electron .",
    "build": "npm run build:ng && npm run build:electron",
    "build:ng": "ng build",
    "build:electron": "node electron/build.mjs",
    "build:native": "bash electron/native/parakeet-coreml/build.sh",
    "verify:stt-catalog": "node scripts/verify-stt-catalog.mjs",
    "package": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "electron-updater": "^6.8.9",
    "node-global-key-listener": "^0.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@types/node": "^26.6.2",
    "concurrently": "^10.0.5",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.1.0"
  }
}
